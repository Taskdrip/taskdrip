# ─────────────────────────────────────────────────────────────────────────────
# Taskdrip — Environment Variables Reference
# Copy this file to .env and fill in your actual values before hosting.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Primary connection string (required). Supports any of the following aliases:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_PRIVATE_URL=
# DATABASE_PUBLIC_URL=
# POSTGRES_URL=

# Individual PG credentials (used as fallback / for direct connections)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
# Set PGSSL=true if your host requires SSL
PGSSL=false

# ── Session ───────────────────────────────────────────────────────────────────
# Strong random string — generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Email — SendGrid ─────────────────────────────────────────────────────────
# Required for transactional emails (password reset, notifications, etc.)
SENDGRID_API_KEY=

# ── AI — Creator Studio ───────────────────────────────────────────────────────
# Provider keys belong in Replit Secrets or Railway service Variables, never in
# the admin form, database, prompts, or source control.
# Groq-hosted open-weight text models:
GROQ_API_KEY=
# Optional OpenAI-compatible endpoint. The endpoint must be reachable by the app.
# For self-hosted Ollama, use an accessible URL such as http://127.0.0.1:11434/v1.
BOOK_AI_BASE_URL=
BOOK_AI_MODEL=llama3.3
# For authenticated OpenAI-compatible services, store the provider key here.
BOOK_AI_API_KEY=
# Optional Groq model override.
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# ── Push Notifications — VAPID ────────────────────────────────────────────────
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@taskdrip.online

# ── Replit Runtime (auto-injected, do NOT set manually on Replit) ─────────────
# REPL_ID=
# REPLIT_DOMAINS=
# REPLIT_DEV_DOMAIN=
